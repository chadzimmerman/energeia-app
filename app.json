{
  "expo": {
    "name": "energeia-app",
    "slug": "energeia-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "energeiaapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/sprites/ui-elements/grand finale/fin_plate_spring.png",
      "resizeMode": "cover",
      "backgroundColor": "#7aa8e3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chadzimmerman.energeia",
      "buildNumber": "7",
      "splash": {
        "image": "./assets/sprites/ui-elements/grand finale/fin_plate_spring.png",
        "resizeMode": "cover",
        "backgroundColor": "#7aa8e3"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "splash": {
        "image": "./assets/sprites/ui-elements/grand finale/fin_plate_spring.png",
        "resizeMode": "cover",
        "backgroundColor": "#7aa8e3"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7aa8e3"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a25c7664-79da-4963-a55e-a84c90de82e0"
      }
    }
  }
}
